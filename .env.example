# Database Configuration
# Copy this file to .env and update with your actual credentials
# DO NOT commit the .env file to version control

DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=inventory_system
DB_PORT=3307

# Application Settings
APP_NAME="Inventory Management System"
APP_ENV=development
APP_DEBUG=true

# Session Settings
SESSION_LIFETIME=30

# Security Settings
# Set to 1 if using HTTPS
SESSION_COOKIE_SECURE=0

# Base URL (without trailing slash)
BASE_URL=http://localhost/inventory%20and%20distribution%20system

# Timezone
TIMEZONE=Asia/Manila

# Error Reporting
ERROR_REPORTING=E_ALL
DISPLAY_ERRORS=1
LOG_ERRORS=1

# File Upload Settings (for future use)
MAX_UPLOAD_SIZE=5M
ALLOWED_FILE_TYPES=pdf,jpg,jpeg,png

# Email Settings (for future notifications)
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@yourdomain.com
MAIL_FROM_NAME="Inventory System"

# Backup Settings
BACKUP_PATH=../backups
AUTO_BACKUP=false
